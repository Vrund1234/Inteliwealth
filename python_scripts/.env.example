# --- Project Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=change_me_local_only
DB_NAME=intelliwealth_layer_db

# --- Master Database (intelli-wealth-backend's own DB — separate credentials/host) ---
MASTER_POSTGRES_HOST=localhost
MASTER_POSTGRES_PORT=5433
MASTER_POSTGRES_USER=your_master_db_user
MASTER_POSTGRES_PASSWORD=change_me_local_only
MASTER_POSTGRES_DB=intelliwealth_master

# --- AWS S3 (this pipeline is the repo's first S3 consumer) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Leave empty for real AWS; set to a MinIO/localstack URL in development.
AWS_S3_ENDPOINT_URL=

# --- intelli-wealth-backend etl-handoff API ---
INTELLIWEALTH_API_BASE=http://127.0.0.1:8000/api/v1
INTELLIWEALTH_RUNNER_EMAIL=de-runner@intelliwealth.com
INTELLIWEALTH_RUNNER_PASSWORD=change_me_local_only
ETL_RUNNER_NAME=de-etl-worker-1

# --- Pipeline tuning ---
# ETL_BATCH_LIMIT is capped server-side at 50; ETL_PEEK_LIMIT at 200.
ETL_BATCH_LIMIT=10
ETL_PEEK_LIMIT=50
ETL_HTTP_TIMEOUT_SECONDS=30
ETL_TOKEN_REFRESH_MARGIN_SECONDS=300
ETL_LOG_DIR=../logs
ETL_LOG_RETENTION_DAYS=30
