# IntelliWealth ETL — environment variable template
# --------------------------------------------------
# Copy this file to .env (same directory) and fill in real credentials.
# NEVER commit .env to version control — it is listed in .gitignore.
#
# All ten variables below are REQUIRED. The application will raise a clear
# RuntimeError at startup if any are missing or empty.

# Project Database - raw warehouse (bronze / silver / gold schemas)
PROJECT_DB_HOST=localhost
PROJECT_DB_PORT=5433
PROJECT_DB_USER=
PROJECT_DB_PASSWORD=
PROJECT_DB_NAME=intelliwealth_raw

# Master Database - backend application DB, read for public.scheme_master
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5433
MASTER_DB_USER=
MASTER_DB_PASSWORD=
MASTER_DB_NAME=intelliwealth
