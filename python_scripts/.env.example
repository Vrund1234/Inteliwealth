# Copy to .env and fill in.  .env is gitignored - never commit real credentials.
# The two databases are configured independently - they may live on
# different hosts, ports or users.

# Project Database - raw warehouse (bronze / silver / gold schemas)
PROJECT_DB_HOST=localhost
PROJECT_DB_PORT=5433
PROJECT_DB_USER=
PROJECT_DB_PASSWORD=
PROJECT_DB_NAME=intelliwealth_raw

# Master Database - backend application DB, read for public.scheme_master
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5433
MASTER_DB_USER=
MASTER_DB_PASSWORD=
MASTER_DB_NAME=intelliwealth
